<?xml version="1.0"?>
<package format="2">
  <name>scout_safety</name>
  <version>0.1.0</version>
  <description>Person-aware speed and separation monitoring for the Scout Mini: filters velocity commands using the RealSense person detections from rs_object_detection.</description>
  <maintainer email="juttu.s@northeastern.edu">agile</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rs_object_detection</exec_depend>
  <exec_depend>scout_bringup</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>direct_lidar_inertial_odometry</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
</package>
