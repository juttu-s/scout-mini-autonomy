Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz/Image
      Name: Detections
      Enabled: true
      Image Topic: /rs_detector/image_annotated
      Transport Hint: raw
      Queue Size: 2
    - Class: rviz/MarkerArray
      Name: Objects
      Enabled: true
      Marker Topic: /rs_detector/markers
      Queue Size: 10
    - Class: rviz/PointCloud2
      Name: Depth Cloud
      Enabled: false
      Topic: /camera/camera/depth/color/points
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
  Enabled: true
  Global Options:
    Fixed Frame: camera_link
    Background Color: 48; 48; 48
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Interact
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 4
      Focal Point: {X: 1.5, Y: 0, Z: 0}
      Pitch: 0.4
      Yaw: 3.14
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1500
