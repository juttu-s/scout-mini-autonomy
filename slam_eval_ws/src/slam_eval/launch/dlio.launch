<launch>
  <!-- DLIO as on the robot (robot.launch): odom + map node, the cfg in dlio_ws; only the console view is off. -->
  <arg name="out" default="/tmp"/>
  <include file="$(find slam_eval)/launch/common.launch"/>
  <include file="$(find direct_lidar_inertial_odometry)/launch/dlio.launch">
    <arg name="pointcloud_topic" value="/livox/lidar"/>
    <arg name="imu_topic"        value="/livox/imu"/>
    <arg name="robot_namespace"  value="/"/>
  </include>
  <param name="/dlio_odom/dlio/verbose" value="false"/>
  <!-- params.yaml has waitUntilMove: true, which holds back the per-scan deskewed cloud (the latency probe's
       output) until the robot has moved; odometry is unaffected. -->
  <param name="/dlio_odom/dlio/map/waitUntilMove" value="false"/>
  <!-- The comparison defines base_link = the MID360 for every method (common.launch, recorded bags). The robot's DLIO
       config moved base_link to the turning centre on 2026-10-23 (baselink2lidar 0.178 m); keep the lidar-frame
       extrinsics here so DLIO stays comparable with the other methods and with earlier results. -->
  <rosparam param="/dlio_odom/dlio/extrinsics/baselink2lidar/t">[0.0, 0.0, 0.0]</rosparam>
  <rosparam param="/dlio_odom/dlio/extrinsics/baselink2imu/t">[-0.042382, -0.019593, 0.020312]</rosparam>
</launch>
