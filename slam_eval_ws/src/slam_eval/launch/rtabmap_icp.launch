<launch>
  <!-- RTAB-Map, lidar variant: ICP odometry on the MID360 (deskewed with the per-point time of /livox/points_ring,
       gravity from the IMU), graph SLAM with RGB-D (colour + aligned depth) for visual loop closure, refined by ICP. -->
  <arg name="out" default="/tmp"/>
  <include file="$(find slam_eval)/launch/common.launch"/>

  <node pkg="rtabmap_sync" type="rgbd_sync" name="rgbd_sync" output="screen">
    <remap from="rgb/image"       to="/camera/camera/color/image_raw"/>
    <remap from="depth/image"     to="/camera/camera/aligned_depth_to_color/image_raw"/>
    <remap from="rgb/camera_info" to="/camera/camera/color/camera_info"/>
    <param name="approx_sync" value="true"/>
    <param name="approx_sync_max_interval" value="0.02"/>
  </node>

  <group ns="rtabmap">
    <node pkg="rtabmap_odom" type="icp_odometry" name="icp_odometry" output="screen">
      <remap from="scan_cloud" to="/livox/points_ring"/>
      <remap from="imu"        to="/livox/imu_ms2"/>
      <remap from="odom"       to="/rtabmap/odom"/>
      <param name="frame_id"        value="base_link"/>
      <param name="odom_frame_id"   value="odom"/>
      <param name="wait_imu_to_init" value="true"/>
      <param name="deskewing"       value="true"/>
      <param name="expected_update_rate" value="15"/>
      <param name="Icp/PointToPlane"           value="true"/>
      <param name="Icp/Iterations"             value="10"/>
      <param name="Icp/VoxelSize"              value="0.1"/>
      <param name="Icp/Epsilon"                value="0.001"/>
      <param name="Icp/PointToPlaneK"          value="20"/>
      <param name="Icp/PointToPlaneRadius"     value="0"/>
      <param name="Icp/MaxTranslation"         value="2"/>
      <param name="Icp/MaxCorrespondenceDistance" value="1.0"/>
      <param name="Icp/OutlierRatio"           value="0.7"/>
      <param name="Icp/CorrespondenceRatio"    value="0.01"/>
      <param name="Odom/ScanKeyFrameThr"       value="0.4"/>
      <param name="OdomF2M/ScanSubtractRadius" value="0.1"/>
      <param name="OdomF2M/ScanMaxSize"        value="15000"/>
      <param name="OdomF2M/BundleAdjustment"   value="false"/>
    </node>

    <node pkg="rtabmap_slam" type="rtabmap" name="rtabmap" output="screen" args="--delete_db_on_start">
      <remap from="rgbd_image" to="/rgbd_image"/>
      <remap from="scan_cloud" to="/livox/points_ring"/>
      <remap from="odom"       to="/rtabmap/odom"/>
      <remap from="imu"        to="/livox/imu_ms2"/>
      <param name="database_path"       value="$(arg out)/rtabmap.db"/>
      <param name="frame_id"            value="base_link"/>
      <param name="subscribe_depth"     value="false"/>
      <param name="subscribe_rgb"       value="false"/>
      <param name="subscribe_rgbd"      value="true"/>
      <param name="subscribe_scan_cloud" value="true"/>
      <param name="approx_sync"         value="true"/>
      <param name="sync_queue_size"     value="30"/>
      <param name="Reg/Strategy"        value="1"/>   <!-- loop closures: visual detection, ICP refinement -->
      <param name="RGBD/CreateOccupancyGrid" value="false"/>
      <param name="RGBD/ProximityMaxGraphDepth" value="0"/>
      <param name="RGBD/ProximityPathMaxNeighbors" value="1"/>
      <param name="RGBD/AngularUpdate"  value="0.05"/>
      <param name="RGBD/LinearUpdate"   value="0.05"/>
      <param name="Mem/NotLinkedNodesKept" value="false"/>
      <param name="Mem/STMSize"         value="30"/>
      <param name="Icp/PointToPlane"    value="true"/>
      <param name="Icp/Iterations"      value="10"/>
      <param name="Icp/VoxelSize"       value="0.1"/>
      <param name="Icp/PointToPlaneK"   value="20"/>
      <param name="Icp/PointToPlaneRadius" value="0"/>
      <param name="Icp/MaxCorrespondenceDistance" value="1.0"/>
      <param name="Icp/OutlierRatio"    value="0.7"/>
      <param name="Icp/CorrespondenceRatio" value="0.2"/>
    </node>
  </group>
</launch>
